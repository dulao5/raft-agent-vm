# Template for an instance. Create a real one with:
#   ./vm new <name> --raft /myserver [--cpu N] [--memory MB] [--disk GB]
# which writes instances/<name>.env. Every setting below is optional except
# RAFT_SERVER (needed only for ./vm raft-setup); unset ones come from defaults.env.

RAFT_SERVER=/myserver
#CPUS=8                 # default: all cores
#MEMORY_MB=16384        # default: half of this Mac's RAM
#DISK_GB=200            # can only grow later: ./vm set-disk <GB>
#BASE_IMAGE=ghcr.io/cirruslabs/ubuntu:latest

# Rarely needed. Defaults are derived from the instance name.
#VM_NAME=               # Tart VM name (default: the instance name)
#GUEST_HOSTNAME=        # hostname set on a fresh clone (default: the instance name)
#RAFT_COMPUTER_NAME=    # name shown in Raft (default: <this Mac's name>-<instance>)
#LAUNCHD_LABEL=         # default: com.tartvm.<instance>
#DISK_OPTS=sync=fsync
