[Unit]
Description=Raft Computer
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/.tiup/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Optional Claude credentials written by `./vm claude-key`.
EnvironmentFile=-%h/.config/raft-vm/env
ExecStart=%h/.local/bin/raft-computer start --foreground
Restart=always
RestartSec=10
LimitNOFILE=1048576
LimitNPROC=infinity

[Install]
WantedBy=default.target
