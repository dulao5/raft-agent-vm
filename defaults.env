# Shared defaults for every instance. A file in instances/ overrides any of these.

BASE_IMAGE=ghcr.io/cirruslabs/ubuntu:latest

# Virtual disk size in GB. It can only grow. The image is sparse, so the Mac
# only spends what the guest actually writes.
DISK_GB=200

# Empty = every logical core of this Mac (the Virtualization framework cannot
# assign more). Several running VMs simply share the cores.
CPUS=

# Empty = half of this Mac's memory. Guest memory is not handed back to macOS
# while the VM runs, so keep the sum over running VMs below the host's RAM.
MEMORY_MB=

# Root disk options for `tart run`. With sync=fsync the guest's flushes reach
# macOS, so killing Tart or crashing loses seconds of writes instead of minutes.
# sync=full is stricter (survives power loss) but slows fsync-heavy work.
DISK_OPTS=sync=fsync

# Raft server slug for `./vm raft-setup`, for example /myserver. Set it per instance.
RAFT_SERVER=
